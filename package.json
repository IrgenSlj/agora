{
  "name": "agora-hub",
  "version": "0.8.0",
  "description": "A written limit for every coding agent and a receipt for every agent-made change. Local-first, open source, no account.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "agora": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IrgenSlj/agora.git"
  },
  "homepage": "https://github.com/IrgenSlj/agora",
  "bugs": "https://github.com/IrgenSlj/agora/issues",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22.22.2"
  },
  "overrides": {
    "qs": "6.15.2",
    "uuid": "13.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "schemas"],
  "scripts": {
    "build": "rm -rf dist && tsc && cp feed/revocations.json dist/revocations.json && mkdir -p dist/policy/defaults && cp src/policy/defaults/* dist/policy/defaults/ && chmod +x dist/cli.js",
    "build:binary": "bun build src/cli.ts --compile --outfile dist/agora",
    "typecheck": "bun run typecheck:cli",
    "typecheck:cli": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "verify:package": "bash scripts/verify-package.sh",
    "test:watch": "vitest",
    "prepublishOnly": "bun run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "refresh:feed": "bun scripts/refresh-feed.ts",
    "build:schemas": "bun scripts/generate-schemas.ts",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "coding-agent",
    "agent-permissions",
    "claude-code",
    "opencode",
    "cedar",
    "policy",
    "in-toto",
    "provenance",
    "receipts",
    "least-privilege"
  ],
  "author": "IrgenSlj",
  "license": "MIT",
  "dependencies": {
    "@cedar-policy/cedar-wasm": "^4.12.0",
    "canonicalize": "^3.0.0",
    "packageurl-js": "^2.0.1",
    "semver": "7.7.2",
    "yargs": "^18.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@types/semver": "7.7.0",
    "@types/yargs": "^17.0.35",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "2.9.0"
  }
}
