// Cedar schema for agora.cedar: what a coding agent may do.
//
// Every session-log event becomes one request: principal is the agent's host,
// action is what it did, resource is what it did it to. `agora policy check`
// validates a policy file against this schema, so a rule reading an attribute
// that does not exist is caught when it is written, not when it never fires.

// The host the agent runs in: "claude-code", "opencode" or "mcp-shim".
entity Agent = {
  host: String,
};

// A file. `path` is repository-relative ("src/app.ts") for files inside the
// repository; outside it, only the class is known and `path` is "class:home",
// "class:tmp", "class:system" or "class:other". `class` is "repo" or that class.
entity File = {
  path: String,
  class: String,
};

// A program a shell command ran first: "git", "bun". Never its arguments.
entity Program = {
  name: String,
};

// A network peer, by host and port.
entity Peer = {
  host: String,
  port: Long,
};

// A tool. MCP tools have `mcp` true and a `server`; built-in tools have `mcp`
// false and `server` "". `revoked` is present only when the revocation list was
// consulted for this server, and every rule reading it must guard with `has`.
entity Tool = {
  name: String,
  server: String,
  mcp: Bool,
  revoked?: Bool,
};

action "read", "write" appliesTo { principal: [Agent], resource: [File] };
action "exec" appliesTo { principal: [Agent], resource: [Program] };
action "connect" appliesTo { principal: [Agent], resource: [Peer] };
action "call" appliesTo { principal: [Agent], resource: [Tool] };
